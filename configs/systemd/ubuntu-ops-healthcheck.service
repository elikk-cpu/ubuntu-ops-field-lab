[Unit]
Description=LAB 01 HTTP API Health Check
After=ubuntu-ops-api.service

[Service]
Type=oneshot
User=developer
Group=app-developers
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8080/health

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
